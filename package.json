{
  "name": "siteflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node --env-file-if-exists=server/.env server/index.js",
    "db:migrate": "node --env-file-if-exists=server/.env server/migrate.js",
    "db:seed": "node --env-file-if-exists=server/.env server/seed.js",
    "test": "node --test server/tests/*.test.js",
    "test:ui": "vitest run",
    "check": "npm test && npm run test:ui && npm run build"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.1",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.2",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
